         a future net8.0-android / net8.0-ios head. Nothing here may reference
         Windows APIs, WPF/Avalonia, or LibVLC. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OpenTv.Core</AssemblyName>
    <RootNamespace>OpenTv.Core</RootNamespace>
  </PropertyGroup>

</Project>
