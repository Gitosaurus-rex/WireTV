<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenTv.Windows.UI.ViewModels"
        xmlns:models="clr-namespace:OpenTv.Core.Models;assembly=OpenTv.Core"
        xmlns:vpn="clr-namespace:OpenTv.Core.Vpn;assembly=OpenTv.Core.Vpn"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="OpenTv.Windows.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="OpenTv settings"
        Width="860" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <TabControl Margin="10">

    <!-- ============ Playlists ============ -->
    <TabItem Header="Playlists">
      <Grid ColumnDefinitions="260,*" Margin="0,10,0,0">

        <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,12,0">
          <Border Grid.Row="0" Classes="panel" Padding="6">
            <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistSource">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="dim" Text="{Binding Kind}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Classes="accent" Content="Add" Command="{Binding AddNewCommand}" />
            <Button Classes="danger"
                    Content="Remove"
                    Command="{Binding RemoveCommand}"
                    IsEnabled="{Binding HasSelection}" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Classes="panel" Padding="18" IsEnabled="{Binding HasSelection}">
          <!-- The Xtream fields make this form taller than the window, so it scrolls. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">

            <TextBlock Classes="heading" Text="Playlist details" />

            <StackPanel Spacing="4">
              <TextBlock Classes="dim" Text="Name" />
              <TextBox Text="{Binding EditName}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="dim" Text="Type" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SourceKinds}"
                        SelectedItem="{Binding EditKind}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="dim" Text="{Binding LocationLabel}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding EditLocation}" />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Margin="8,0,0,0"
                        IsVisible="{Binding !IsXtreamSource}"
                        Command="{Binding BrowseCommand}" />
              </Grid>
            </StackPanel>

            <!-- Credentials apply to Xtream Codes only. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsXtreamSource}">
              <TextBlock Classes="dim" Text="Username" />
              <TextBox Text="{Binding EditUsername}" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding IsXtreamSource}">
              <TextBlock Classes="dim" Text="Password" />
              <TextBox Text="{Binding EditPassword}" PasswordChar="*" />
              <TextBlock Classes="dim"
                         TextWrapping="Wrap"
                         Text="Stored encrypted with Windows DPAPI under your user account." />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="dim" Text="XMLTV EPG URL (optional, used from a later iteration)" />
              <TextBox Text="{Binding EditEpgUrl}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
              <Button Content="Test connection"
                      IsVisible="{Binding IsXtreamSource}"
                      IsEnabled="{Binding !IsTesting}"
                      Command="{Binding TestConnectionCommand}" />
              <TextBlock Classes="dim"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="260"
                         Text="{Binding Feedback}"
                         IsVisible="{Binding Feedback, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </TabItem>

    <!-- ============ VPN ============ -->
    <TabItem Header="VPN">
      <Grid ColumnDefinitions="260,*" Margin="0,10,0,0" DataContext="{Binding Vpn}" x:DataType="vm:VpnViewModel">

        <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,12,0">
          <Border Grid.Row="0" Classes="panel" Padding="6">
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vpn:VpnProfile">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="dim" Text="{Binding Kind}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Classes="accent" Content="Import .conf" Command="{Binding ImportProfileCommand}" />
            <Button Classes="danger" Content="Remove" Command="{Binding RemoveProfileCommand}" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Classes="panel" Padding="18">
          <StackPanel Spacing="14">

            <TextBlock Classes="heading" Text="WireGuard tunnel" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="11" Height="11" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Classes="dim"
                       TextWrapping="Wrap"
                       Text="{Binding StatusDetail}"
                       IsVisible="{Binding StatusDetail, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent"
                      Content="Connect"
                      Command="{Binding ConnectCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="Disconnect"
                      Command="{Binding DisconnectCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <Border Classes="panel"
                    Padding="12"
                    IsVisible="{Binding BackendWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
              <TextBlock TextWrapping="Wrap" Foreground="#F0A44A" Text="{Binding BackendWarning}" />
            </Border>

            <TextBlock Classes="dim"
                       TextWrapping="Wrap"
                       Text="Starting or stopping a tunnel needs administrator rights, so Windows shows a UAC prompt each time. The tunnel keeps running after OpenTv is closed - disconnect here to stop it." />

          </StackPanel>
        </Border>
      </Grid>
    </TabItem>

  </TabControl>
</Window>
