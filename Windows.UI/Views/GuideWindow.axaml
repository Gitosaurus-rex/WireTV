<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenTv.Windows.UI.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="OpenTv.Windows.UI.Views.GuideWindow"
        x:DataType="vm:GuideViewModel"
        Title="TV guide"
        Width="1120" Height="720"
        MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="340,*" Margin="12">

    <!-- ============ Channels ============ -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
      <TextBox Grid.Row="0"
               Watermark="Search channels"
               Text="{Binding SearchText}"
               Margin="0,0,0,8" />

      <Border Grid.Row="1" Classes="panel" Padding="6">
        <ListBox ItemsSource="{Binding Channels}"
                 SelectedItem="{Binding SelectedChannel}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChannelListItemViewModel">
              <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        Background="{StaticResource AppSurfaceAlt}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding Number, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Number}" FontSize="11" />
                </Border>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="dim"
                             Text="{Binding NowTitle}"
                             TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasNow}" />
                  <TextBlock Classes="dim"
                             Text="{Binding Group}"
                             TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding !HasNow}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <!-- ============ Schedule ============ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0"
                   Classes="heading"
                   Margin="0"
                   VerticalAlignment="Center"
                   Text="{Binding SelectedChannel.Name, FallbackValue='TV guide'}" />

        <ComboBox Grid.Column="2"
                  MinWidth="150"
                  ItemsSource="{Binding Days}"
                  SelectedItem="{Binding SelectedDay}"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GuideDayViewModel">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="3"
                Content="Now"
                Margin="8,0,0,0"
                Command="{Binding GoToNowCommand}"
                VerticalAlignment="Center" />
      </Grid>

      <Border Grid.Row="1" Classes="panel" Padding="6">
        <Panel>
          <ListBox x:Name="ProgrammeList"
                   ItemsSource="{Binding Programmes}"
                   SelectedItem="{Binding SelectedProgramme}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GuideProgrammeViewModel">
                <Grid ColumnDefinitions="90,*" Margin="0,2">

                  <TextBlock Grid.Column="0"
                             Text="{Binding TimeRange}"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             FontSize="12"
                             Margin="0,2,10,0"
                             VerticalAlignment="Top" />

                  <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Background="{StaticResource AppAccent}"
                              CornerRadius="3"
                              Padding="6,1"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsAiringNow}">
                        <TextBlock Text="NOW" FontSize="10" FontWeight="Bold" Foreground="#0B1220" />
                      </Border>
                    </StackPanel>

                    <TextBlock Classes="dim"
                               Text="{Binding SubTitle}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SubTitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                    <ProgressBar Height="3"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 IsVisible="{Binding IsAiringNow}" />

                    <TextBlock Classes="dim" Text="{Binding Meta}" />

                    <TextBlock Classes="dim"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Shown when the channel matched no guide data, or the day is empty. -->
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Classes="dim"
                     TextWrapping="Wrap"
                     MaxWidth="360"
                     TextAlignment="Center"
                     Text="{Binding StatusText}"
                     IsVisible="{Binding !HasProgrammes}" />
        </Panel>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBlock Grid.Column="0" Classes="dim" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="accent"
                Content="Watch this channel"
                Command="{Binding PlaySelectedCommand}"
                IsEnabled="{Binding HasSelection}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
