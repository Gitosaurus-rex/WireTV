<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenTv.Windows.UI.ViewModels"
        xmlns:models="clr-namespace:OpenTv.Core.Models;assembly=OpenTv.Core"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:controls="clr-namespace:OpenTv.Windows.UI.Controls"
        x:Class="OpenTv.Windows.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OpenTv"
        Width="1280" Height="760"
        MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ExitFullScreenCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding NextChannelCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding PreviousChannelCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ============ Top bar: provider selection + VPN status ============ -->
    <Border Grid.Row="0"
            Background="{StaticResource AppSurface}"
            BorderBrush="{StaticResource AppBorder}"
            BorderThickness="0,0,0,1"
            Padding="12,8"
            IsVisible="{Binding !IsFullScreen}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Column="0"
                   Text="OpenTv"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="4,0,16,0" />

        <ComboBox Grid.Column="1"
                  MinWidth="220"
                  ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource}"
                  PlaceholderText="No playlist"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:PlaylistSource">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="2"
                Content="Refresh"
                Margin="8,0,0,0"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsIdle}"
                VerticalAlignment="Center" />

        <!-- VPN status badge. The dot colour is the quickest read of tunnel state. -->
        <Border Grid.Column="4"
                Classes="panel"
                Padding="10,6"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding Vpn.StatusDetail}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="9" Height="9" Fill="{Binding Vpn.StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Vpn.StatusLabel}" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
        </Border>

        <Button Grid.Column="5"
                Margin="8,0,0,0"
                Command="{Binding Vpn.ToggleCommand}"
                IsEnabled="{Binding !Vpn.IsBusy}"
                VerticalAlignment="Center">
          <Panel>
            <TextBlock Text="Disconnect" IsVisible="{Binding Vpn.IsConnected}" />
            <TextBlock Text="Connect" IsVisible="{Binding !Vpn.IsConnected}" />
          </Panel>
        </Button>

        <Button Grid.Column="6"
                Content="TV guide"
                Margin="8,0,0,0"
                Command="{Binding OpenGuideCommand}"
                IsEnabled="{Binding HasChannels}"
                ToolTip.Tip="{Binding EpgStatus}"
                VerticalAlignment="Center" />

        <Button Grid.Column="7"
                Content="Settings"
                Margin="8,0,0,0"
                Command="{Binding OpenSettingsCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ============ Body: channel sidebar + video ============ -->
    <DockPanel Grid.Row="1">

      <Border DockPanel.Dock="Left"
              Width="330"
              Background="{StaticResource AppSurface}"
              BorderBrush="{StaticResource AppBorder}"
              BorderThickness="0,0,1,0"
              IsVisible="{Binding !IsFullScreen}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

          <TextBox Grid.Row="0"
                   Watermark="Search channels"
                   Text="{Binding SearchText}"
                   Margin="0,0,0,8" />

          <ComboBox Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup}"
                    Margin="0,0,0,8" />

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Channels}"
                   SelectedItem="{Binding SelectedChannel}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelListItemViewModel">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Grid.Column="0"
                          Background="{StaticResource AppSurfaceAlt}"
                          CornerRadius="3"
                          Padding="6,2"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding Number, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding Number}" FontSize="11" />
                  </Border>

                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />

                    <!-- The group is a fallback caption until the guide arrives. -->
                    <TextBlock Classes="dim"
                               Text="{Binding Group}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !HasNow}" />

                    <TextBlock Classes="dim"
                               Text="{Binding NowTitle}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasNow}" />

                    <ProgressBar Height="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding NowProgress}"
                                 IsVisible="{Binding HasNow}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- First-run empty state, shown instead of an unexplained blank list. -->
          <Border Grid.Row="2"
                  Classes="panel"
                  Padding="16"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !HasChannels}">
            <StackPanel Spacing="12">
              <TextBlock Classes="heading" Text="No channels" />
              <TextBlock Classes="dim"
                         TextWrapping="Wrap"
                         Text="Add an M3U playlist by URL or file under Settings, then pick it in the top bar." />
              <Button Classes="accent"
                      Content="Open settings"
                      HorizontalAlignment="Left"
                      Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="3"
                     Classes="dim"
                     Margin="2,8,0,0"
                     Text="{Binding Channels.Count, StringFormat=&apos;{}{0} channels listed&apos;}" />
        </Grid>
      </Border>

      <Grid RowDefinitions="*,Auto">

        <!-- VideoView is a native child window, so Avalonia controls cannot be
             composited on top of it. The transport bar therefore sits below the
             video rather than floating over it. -->
        <Border Grid.Row="0"
                Background="{StaticResource AppVideoBackground}"
                DoubleTapped="OnVideoDoubleTapped">
          <Panel>
            <!-- MediaPlayer is attached from code-behind once the native window
                 handle exists; binding it here can run before that and makes
                 libvlc open its own top-level output window instead. -->
            <controls:VideoSurface x:Name="Video" />

            <Border Background="#991040FF"
                    Margin="60"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40,24">
              <TextBlock Text="OVERLAY TEST"
                         FontSize="48"
                         FontWeight="Bold"
                         Foreground="White" />
            </Border>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Classes="dim"
                       IsVisible="{Binding !Player.IsPlaying}"
                       Text="{Binding Player.StatusText}" />
          </Panel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource AppSurface}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

            <Button Grid.Column="0"
                    Classes="icon"
                    FontFamily="Segoe UI Symbol"
                    Command="{Binding Player.TogglePlayPauseCommand}"
                    ToolTip.Tip="Play / pause">
              <Panel>
                <TextBlock Text="&#x23F8;&#xFE0E;" IsVisible="{Binding Player.IsPlaying}" />
                <TextBlock Text="&#x25B6;&#xFE0E;" IsVisible="{Binding !Player.IsPlaying}" />
              </Panel>
            </Button>

            <Button Grid.Column="1"
                    Classes="icon"
                    Margin="6,0,0,0"
                    FontFamily="Segoe UI Symbol"
                    Content="&#x25A0;&#xFE0E;"
                    Command="{Binding Player.StopCommand}"
                    ToolTip.Tip="Stop" />

            <Button Grid.Column="2"
                    Classes="icon"
                    Margin="6,0,0,0"
                    FontFamily="Segoe UI Symbol"
                    Content="&#x27F3;&#xFE0E;"
                    Command="{Binding Player.ReloadCommand}"
                    ToolTip.Tip="Reconnect" />

            <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Player.ChannelName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="dim" Text="{Binding Player.StatusText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="4"
                    Command="{Binding Player.ToggleMuteCommand}"
                    VerticalAlignment="Center">
              <Panel>
                <TextBlock Text="Unmute" IsVisible="{Binding Player.IsMuted}" />
                <TextBlock Text="Mute" IsVisible="{Binding !Player.IsMuted}" />
              </Panel>
            </Button>

            <Slider Grid.Column="5"
                    Width="130"
                    Margin="10,0"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding Player.Volume}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Volume" />

            <Button Grid.Column="6"
                    Classes="icon"
                    FontFamily="Segoe UI Symbol"
                    Content="&#x26F6;&#xFE0E;"
                    Command="{Binding ToggleFullScreenCommand}"
                    ToolTip.Tip="Full screen (F11)" />
          </Grid>
        </Border>
      </Grid>
    </DockPanel>

    <!-- ============ Status bar ============ -->
    <Border Grid.Row="2"
            Background="{StaticResource AppSurface}"
            BorderBrush="{StaticResource AppBorder}"
            BorderThickness="0,1,0,0"
            Padding="12,6"
            IsVisible="{Binding !IsFullScreen}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <ProgressBar Grid.Column="0"
                     Width="90"
                     Height="4"
                     IsIndeterminate="True"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsBusy}" />
        <TextBlock Grid.Column="1" Classes="dim" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Classes="dim"
                   Margin="0,0,16,0"
                   VerticalAlignment="Center"
                   Text="{Binding EpgStatus}" />
        <TextBlock Grid.Column="3"
                   Classes="dim"
                   VerticalAlignment="Center"
                   Text="{Binding TotalChannelCount, StringFormat=&apos;{}{0} channels loaded&apos;}" />
      </Grid>
    </Border>

  </Grid>
</Window>
